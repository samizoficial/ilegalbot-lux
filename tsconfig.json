{
	"compilerOptions": {
	  "target": "ES2021",
	  "module": "ESNext",
	  "moduleResolution": "Node",
	  "outDir": "build",
	  "rootDir": "src",
	  "strict": true,
	  "esModuleInterop": true,
	  "forceConsistentCasingInFileNames": true,
	  "skipLibCheck": true,
	  "resolveJsonModule": true,
	  "types": ["node"],
	  "allowSyntheticDefaultImports": true,
	  "allowJs": false,
	  "noEmitOnError": true
	},
	"include": [
	  "src/**/*.ts"
	],
	"exclude": [
	  "node_modules",
	  "build"
	]
  }
  